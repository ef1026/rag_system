    </node>
    <node id="Linear Requirement">
      <data key="d0">Linear Requirement</data>
      <data key="d1">concept</data>
      <data key="d2">A requirement for amplifiers to maintain the information in a signal without introducing new information or distortion.</data>
      <data key="d3">chunk-19dab0b0d0f5732d8dae08612cd92992</data>
      <data key="d4">RAG_test1.pdf</data>
      <data key="d5">1770441645</data>
      <data key="d6" />
    </node>
    <node id="Distortion">
      <data key="d0">Distortion</data>
      <data key="d1">concept</data>
      <data key="d2">An undesirable change in the waveform of a signal after amplification.</data>
      <data key="d3">chunk-19dab0b0d0f5732d8dae08612cd92992</data>
      <data key="d4">RAG_test1.pdf</data>
      <data key="d5">1770441645</data>
      <data key="d6" />
    </node>
