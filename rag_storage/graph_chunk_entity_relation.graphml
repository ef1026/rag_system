    <edge source="Sinusoidal Signal" target="Peak Amplitude">
      <data key="d7">1.0</data>
      <data key="d8">A sinusoidal signal is characterized by its peak amplitude V_a, which is its maximum voltage value.</data>
      <data key="d9">parameter,signal characteristic</data>
      <data key="d10">chunk-db51dd6aa7f66f035b774eb00b1181eb</data>
      <data key="d11">RAG_test1.pdf</data>
      <data key="d12">1770441645</data>
      <data key="d13" />
    </edge>
    <edge source="Sinusoidal Signal" target="Angular Frequency">
      <data key="d7">1.0</data>
      <data key="d8">A sinusoidal signal is characterized by its angular frequency ω, which determines its rate of oscillation.</data>
      <data key="d9">parameter,signal characteristic</data>
      <data key="d10">chunk-db51dd6aa7f66f035b774eb00b1181eb</data>
      <data key="d11">RAG_test1.pdf</data>
