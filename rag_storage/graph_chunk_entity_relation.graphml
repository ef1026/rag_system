    <node id="Symmetric Square Wave">
      <data key="d0">Symmetric Square Wave</data>
      <data key="d1">concept</data>
      <data key="d2">A periodic, non-sinusoidal waveform with odd symmetry and half-wave symmetry, characterized by its sharp transitions between two constant values.</data>
