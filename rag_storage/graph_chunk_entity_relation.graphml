      <data key="d13" />
    </edge>
    <edge source="Sinusoidal Signal" target="Phase">
      <data key="d7">1.0</data>
      <data key="d8">A sinusoidal signal is characterized by its phase, which determines its initial angle at a reference time.</data>
      <data key="d9">parameter,signal characteristic</data>
      <data key="d10">chunk-db51dd6aa7f66f035b774eb00b1181eb</data>
      <data key="d11">RAG_test1.pdf</data>
      <data key="d12">1770441645</data>
      <data key="d13" />
    </edge>
    <edge source="Sinusoidal Signal" target="Root Mean Square (rms) Value">
      <data key="d7">1.0</data>
      <data key="d8">The magnitude of a sinusoidal signal is often expressed by its root mean square (rms) value, which is its peak amplitude divided by the square root of 2.</data>
      <data key="d9">effective magnitude,measurement</data>
      <data key="d10">chunk-db51dd6aa7f66f035b774eb00b1181eb</data>
      <data key="d11">RAG_test1.pdf</data>
