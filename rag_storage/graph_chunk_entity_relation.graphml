    <edge source="Image" target="Captions">
      <data key="d7">4.0</data>
      <data key="d8">The Image has associated Captions that describe its content and figure labels.&lt;SEP&gt;The Image has associated Captions that describe its content.&lt;SEP&gt;The captions provide a textual description and label for the content of the image.</data>
      <data key="d9">annotation,description,labeling</data>
      <data key="d10">chunk-c8f2228a703be8bef62ad5b8318bb5af&lt;SEP&gt;chunk-8ba2ced186359c941c816e5e5eda762f&lt;SEP&gt;chunk-905f3d2f135d774def7cdb42035893ea&lt;SEP&gt;chunk-06ca6310ef4a9d4c86d66da037b22eaa</data>
