# Copy this file to .env, then fill in your own keys.
# .env is the only runtime config file used by this project.

# Multimodal processing. Keep model keys server-side; the frontend only calls FastAPI.
ENABLE_MULTIMODAL=true
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true
ENABLE_FORMULA_PROCESSING=true
ENABLE_GENERIC_PROCESSING=true

# Multimodal item limits. 0, -1, unlimited, or none means unlimited.
# Set a positive integer to cap processing cost, for example MAX_IMAGE_ITEMS=5
# or MAX_EQUATION_ITEMS=10.
MAX_IMAGE_ITEMS=0
MAX_TABLE_ITEMS=0
MAX_EQUATION_ITEMS=0
MAX_FORMULA_ITEMS=0
MAX_GENERIC_ITEMS=0

# Qwen/DashScope vision configuration.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max

# LightRAG text generation uses the OpenAI-compatible DashScope endpoint.
LLM_MODEL=qwen-plus
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=

# Local embedding model used by the FastAPI backend.
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# Rerank runs only in the backend. Disable it explicitly if your key has no
# rerank model access.
ENABLE_RERANK=true
RERANK_BINDING=aliyun
RERANK_MODEL=qwen3-rerank
RERANK_BINDING_API_KEY=
# Optional overrides.
# RERANK_BASE_URL=
# RERANK_TOP_N=10

# Fast text mode favors lower latency. Rerank stays available globally, but is
# disabled inside fast text unless explicitly re-enabled here.
CHAT_FAST_TEXT_QUERY_MODE=naive
CHAT_FAST_TEXT_ENABLE_RERANK=false
CHAT_FAST_TEXT_SUMMARY_CHARS_PER_DOC=4000
CHAT_FAST_TEXT_SUMMARY_MAX_TOKENS=2600
CHAT_FAST_TEXT_SUMMARY_MODEL=

# Frontend origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinerU 2.7.6 parser settings.
# GPU mode is enabled by using the pipeline backend plus a CUDA device.
PARSER=mineru
PARSE_METHOD=auto
MINERU_BACKEND=pipeline
MINERU_DEVICE=cuda
MINERU_SOURCE=modelscope
# MINERU_DEVICE=cuda:0
# MINERU_VRAM=8

# Runtime directories.
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output

# Query mode: naive, local, global, hybrid, mix, or bypass.
QUERY_MODE=hybrid
